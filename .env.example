# Template for the secret settings file.
# HOW TO USE: copy this file, name the copy `.env.local`, and paste the real
# values after each "=". `.env.local` is ignored by Git, so keys never get pushed.
# This file (.env.example) is committed, so it must NEVER contain real values.

# --- Supabase (Dashboard > Project Settings > API Keys / Data API) ---

# The project's web address, e.g. https://<project-ref>.supabase.co
# Safe for the browser (that's what NEXT_PUBLIC_ means).
NEXT_PUBLIC_SUPABASE_URL=

# The "publishable" key (starts with sb_publishable_). Older screens call it the "anon" key.
# Safe for the browser: Row Level Security decides what it can see.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The "secret" key (starts with sb_secret_). Older screens call it the "service_role" key.
# SERVER ONLY. It skips all security rules. Never use it in browser code.
# Used only by the PayMongo webhook and the PayMongo return check (Step 12),
# because only this key may mark a booking as paid.
SUPABASE_SECRET_KEY=

# --- PayMongo, TEST mode (Phase D) ---

# PayMongo secret key (starts with sk_test_). SERVER ONLY.
# PayMongo dashboard > Developers > API Keys > Secret key (test mode).
# Used to open checkout pages, check if they were paid, and close them.
PAYMONGO_SECRET_KEY=

# Secret used to check that webhook messages really come from PayMongo. SERVER ONLY.
# You get it when you add the webhook in PayMongo (Developers > Webhooks), once the
# site is online (Step 13): https://<your-site>/api/paymongo/webhook
# Can stay empty on localhost (the return check confirms payments there).
PAYMONGO_WEBHOOK_SECRET=

# --- Site ---

# The website's own address, used for redirect links (http://localhost:3000 while developing).
# PayMongo sends clients back to <this address>/book/pay/<booking>/return after paying.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Emails: Gmail SMTP with an App Password (Version 1.4) ---
# SERVER ONLY. Used by the admin Communications page and the "your email was
# changed" alert (src/lib/email.ts). Leave empty and the site still works:
# it just says email sending isn't set up yet.

# Gmail's mail server and port (465 = encrypted from the start).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# The Gmail address that sends the emails, e.g. block69cafe@gmail.com
SMTP_USER=
# The 16-letter Google App Password (NOT the normal Gmail password).
# Google Account > Security > 2-Step Verification ON > App passwords.
SMTP_PASS=
# Who the email says it's from, e.g. Block 69 Cafe <block69cafe@gmail.com>
EMAIL_FROM=
