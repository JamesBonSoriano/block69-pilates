# Files and folders Git should never save (GitHub Desktop will hide these).

# Secret keys: .env.local holds the real keys and must NEVER be committed.
# (.env.example is safe to commit: it has key names only, no values.)
.env
.env.local
.env*.local
# Safety net: make sure the key-names-only template is never hidden by the lines above
!.env.example

# Private certificate/key files (never commit these either)
*.pem

# Installed packages (anyone can re-create them with `npm install`)
node_modules/
hfjh
# Next.js build output (re-created by `npm run dev` / `npm run build`)
.next/
out/
build/
next-env.d.ts
*.tsbuildinfo

# Test coverage reports (made by test tools, re-created any time)
coverage/

# Vercel's local link folder
.vercel/

# Supabase CLI temporary files (also listed in supabase/.gitignore)
supabase/.temp/
supabase/.branches/

# Logs and system junk
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db
